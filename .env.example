# Pi Web + Cloudflare Tunnel 本机配置
# 复制此文件为 .env.local 并填写真实值。.env.local 已被 git 忽略，不会入库。

# Pi Web 访问密码（必填，暴露到公网前一定要设置强密码）
PI_WEB_PASSWORD=

# Pi Web 监听端口与地址
PI_WEB_PORT=30141
PI_WEB_HOSTNAME=127.0.0.1

# Cloudflare Tunnel 对外域名，必须与 Zero Trust 里配置的 Public Hostname 一致
PI_WEB_ALLOWED_HOSTS=

# Cloudflare Tunnel Token（Zero Trust 控制台创建隧道后获得，通常以 eyJ 开头）
CLOUDFLARE_TUNNEL_TOKEN=
