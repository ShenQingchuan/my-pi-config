{
  "name": "my-pi-config",
  "private": true,
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "update-extensions": "bun run scripts/update-extensions.ts",
    "test": "bun test",
    "stack:start": "pm2 start ecosystem.config.cjs",
    "stack:stop": "pm2 stop ecosystem.config.cjs",
    "stack:restart": "pm2 restart ecosystem.config.cjs",
    "stack:status": "pm2 list",
    "stack:logs": "pm2 logs",
    "stack:save": "pm2 save",
    "stack:autostart": "bun run scripts/stack-autostart.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/bun": "^1.4.2",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3"
  }
}
